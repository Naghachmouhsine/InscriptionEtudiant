@using InscriptionEtudiant.Models
@model InscriptionEtudiant.ViewModels.Admin.AdminDossierListViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Etude Dossier";
   
}
@functions{
    private string GetBadge(InscriptionEtudiant.Models.StatutDossier s)
    {
        return s switch
        {
            InscriptionEtudiant.Models.StatutDossier.EnAttente => "<span class=\"badge bg-secondary\">En attente</span>",
            InscriptionEtudiant.Models.StatutDossier.Incomplet => "<span class=\"badge bg-warning text-dark\">Incomplet</span>",
            InscriptionEtudiant.Models.StatutDossier.Accepte => "<span class=\"badge bg-success\">Accepté</span>",
            InscriptionEtudiant.Models.StatutDossier.Refuse => "<span class=\"badge bg-danger\">Refusé</span>",
            _ => $"<span class=\"badge bg-light text-dark\">{s}</span>"
        };
    }
}

@{
    ViewData["Title"] = "Gestion des dossiers étudiants";
}

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Gestion des dossiers étudiants</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-sm-5">
                    <label class="form-label">Recherche</label>
                    <input name="recherche" class="form-control" placeholder="Nom, CNE, email..." />
                </div>
                <div class="col-sm-3">
                    <label class="form-label">Statut</label>
                    <select name="statut" class="form-select">
                        <option value="">Tous</option>
                        <option value="EnAttente">En attente</option>
                        <option value="Incomplet">Incomplet</option>
                        <option value="Accepte">Accepté</option>
                        <option value="Refuse">Refusé</option>
                    </select>
                </div>
                <div class="col-sm-2">
                    <button class="btn btn-primary w-100" type="submit"><i class="bi bi-search me-1"></i> Rechercher</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>CNE</th>
                        <th>Étudiant</th>
                        <th>Email</th>
                        <th>Date dépôt</th>
                        <th>Filière</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Dossiers != null)
                    {
                        var i = 1;
                        foreach (var item in Model.Dossiers)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@item.CNE</td>
                                <td>@item.NomComplet</td>
                                <td>@item.Email</td>
                                <td>@item.DateDepot.ToString("yyyy-MM-dd")</td>
                                <td>@item.FilierePrincipale</td>
                                <td>@Html.Raw(GetBadge(item.Statut))</td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", "Dossiers", new { id = item.Id })"><i class="bi bi-eye"></i> Voir détail</a>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="8">Aucun dossier trouvé.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
