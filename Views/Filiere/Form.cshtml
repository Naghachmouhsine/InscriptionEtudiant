@model InscriptionEtudiant.ViewModels.FiliereFormViewModel
@{
    Layout = "_AdminLayout";
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? "Modifier une filière" : "Ajouter une filière";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">@ViewData["Title"]</h3>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Retour</a>
        </div>
    </div>

    <div class="card card-rounded shadow-sm">
        <div class="card-body">
            <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" novalidate onsubmit="return validateFiliereForm(this)">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label class="form-label">Nom</label>
                    <input asp-for="Nom" class="form-control" maxlength="100" required />
                    <span asp-validation-for="Nom" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" maxlength="500" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Capacité</label>
                    <input asp-for="Capacite" type="number" min="1" class="form-control" required />
                    <span asp-validation-for="Capacite" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Date début inscription</label>
                        <input asp-for="DateDebutInscription" type="date" class="form-control" required />
                        <span asp-validation-for="DateDebutInscription" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Date fin inscription</label>
                        <input asp-for="DateFinInscription" type="date" class="form-control" required />
                        <span asp-validation-for="DateFinInscription" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">@(isEdit ? "Mettre à jour" : "Enregistrer")</button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/filiere.js"></script>
}
