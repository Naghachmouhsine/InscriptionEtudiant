@* Reusable candidate sidebar partial. No business logic here. *@
<aside class="candidate-sidebar bg-white border-end" style="width:220px;min-height:100vh;position:sticky;top:0;">
    <div class="p-3">
        <a class="d-flex align-items-center text-decoration-none" asp-controller="Candidat" asp-action="Index">
            <span class="fs-4 rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center me-2" style="width:36px;height:36px;">C</span>
            <div class="d-flex flex-column">
                <span class="fw-semibold">Espace Candidat</span>
                <small class="text-muted">Tableau de bord</small>
            </div>
        </a>
    </div>

    <nav class="nav flex-column px-2">
        <a class="nav-link d-flex align-items-center py-2 px-3" asp-controller="Candidat" asp-action="Index">
            <i class="bi bi-speedometer2 me-2"></i>
            Dashboard
        </a>
        <a class="nav-link d-flex align-items-center py-2 px-3"
           asp-area=""
           asp-controller="Inscription"
           asp-action="Index">

            <i class="bi bi-journal-plus me-2"></i>
            Inscription
        </a>
    </nav>
</aside>
